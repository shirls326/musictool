<Window x:Class="MusicTool.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio settings"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#202129"
        Foreground="#F6F4FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2C36" />
            <Setter Property="Foreground" Value="#F6F4FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Matches the light time-signature ComboBox in MainWindow; the default WPF
             ComboBox template does not render a dark background reliably. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F6F4FA" />
            <Setter Property="Foreground" Value="#17131F" />
            <Setter Property="BorderBrush" Value="#555662" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="InUseText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,16" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="InputComboBox" AutomationProperties.Name="Microphone" />
        <TextBlock x:Name="InputInUseText" Style="{StaticResource InUseText}" />

        <TextBlock Text="Output (headphones)" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="OutputComboBox" AutomationProperties.Name="Output (headphones)" />
        <TextBlock x:Name="OutputInUseText" Style="{StaticResource InUseText}" />

        <TextBlock Text="Playback and input monitoring both use this output." Foreground="#9A9AA8"
                   TextWrapping="Wrap" Margin="0,-10,0,16" />
        <TextBlock x:Name="MonitoringStatusText" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Background="#5B4A9E" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
