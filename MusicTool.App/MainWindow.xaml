<Window x:Class="MusicTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Tool"
        Width="1280"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        Background="#14151A"
        Foreground="#F6F4FA"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1C1D24" />
        <SolidColorBrush x:Key="Raised" Color="#252630" />
        <SolidColorBrush x:Key="MutedText" Color="#9A9AA8" />
        <SolidColorBrush x:Key="Purple" Color="#B69CFF" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2B2C36" />
            <Setter Property="Foreground" Value="#F6F4FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20212A" />
            <Setter Property="Foreground" Value="#F6F4FA" />
            <Setter Property="BorderBrush" Value="#393A46" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Purple}" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
        </Style>
        <Style x:Key="ProjectMenuButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C4C3CF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30313A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A3B46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProjectMenuActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E7EE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#363742" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#41424D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#20212A" />
            <Setter Property="Foreground" Value="#F6F4FA" />
            <Setter Property="BorderBrush" Value="#393A46" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252630" />
                        <Setter Property="Foreground" Value="#F6F4FA" />
                        <Setter Property="Padding" Value="6,4" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#B69CFF" />
                                <Setter Property="Foreground" Value="#17131F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#B69CFF" />
                                <Setter Property="Foreground" Value="#17131F" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#202129" BorderBrush="#30313A" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ProjectMenuButton" Style="{StaticResource ProjectMenuButtonStyle}"
                            Width="32" Height="32" Padding="0" Margin="0,0,4,0"
                            ToolTip="More project actions"
                            AutomationProperties.Name="More project actions" Click="ProjectMenu_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
                            <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
                            <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ProjectNameText" FontSize="13" FontWeight="SemiBold"
                               MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Text, ElementName=ProjectNameText}" />
                </StackPanel>
                <Popup x:Name="ProjectMenuPopup" PlacementTarget="{Binding ElementName=ProjectMenuButton}"
                       Placement="Bottom" VerticalOffset="6" HorizontalOffset="-4"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                    <Border Background="#22232B" BorderBrush="#3A3B45" BorderThickness="1"
                            CornerRadius="8" Padding="5" MinWidth="190">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28" />
                        </Border.Effect>
                        <StackPanel>
                            <Button Content="New project" Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    Click="NewProject_Click" />
                            <Button Content="Open project..." Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    Click="OpenProject_Click" />
                            <Border Height="1" Background="#3A3B45" Margin="8,4" />
                            <Button Content="Import audio..." Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    Click="AddAudio_Click" />
                            <Border Height="1" Background="#3A3B45" Margin="8,4" />
                            <Button x:Name="UndoRecordingButton" Content="Undo latest recording  Ctrl+Z"
                                    Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    IsEnabled="False" Click="UndoRecording_Click" />
                            <Border Height="1" Background="#3A3B45" Margin="8,4" />
                            <Button x:Name="AudioSettingsButton" Content="Audio settings..."
                                    Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    ToolTip="Choose the microphone and output (headphones)"
                                    Click="AudioSettings_Click" />
                            <Border Height="1" Background="#3A3B45" Margin="8,4" />
                            <Button Content="Save" Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    Click="Save_Click" />
                            <Button Content="Save copy..." Style="{StaticResource ProjectMenuActionButtonStyle}"
                                    Click="SaveAs_Click" />
                        </StackPanel>
                    </Border>
                </Popup>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,16,0">
                    <StackPanel.Resources>
                        <Style x:Key="TransportButtonStyle" TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="1" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="PlayButton" Style="{StaticResource TransportButtonStyle}"
                            AutomationProperties.Name="Play" ToolTip="Play from playhead" Click="Play_Click">
                        <Grid>
                            <Path x:Name="PlayIcon" Data="M 10,6 L 19,12 L 10,18 Z" Fill="#F6F4FA"
                                  Stretch="Uniform" Width="18" Height="18" />
                            <Path x:Name="PauseIcon"
                                  Data="M 6,5 L 10,5 L 10,19 L 6,19 Z M 14,5 L 18,5 L 18,19 L 14,19 Z"
                                  Fill="#F6F4FA" Stretch="Uniform" Width="18" Height="18"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}"
                            AutomationProperties.Name="Stop" ToolTip="Stop playback" Click="Stop_Click">
                        <Rectangle Width="13" Height="13" Fill="#F6F4FA" />
                    </Button>
                    <Border Width="1" Height="30" Background="#393A44" Margin="4,0" />
                    <Button x:Name="RecordButton" Style="{StaticResource TransportButtonStyle}"
                            AutomationProperties.Name="Record vocal"
                            ToolTip="Record from the playhead on the selected track (punch in)"
                            Background="#33252B" Click="Record_Click">
                        <Grid Width="18" Height="18">
                            <Ellipse x:Name="RecordDot" Width="12" Height="12" Fill="#FF5964" />
                            <Rectangle x:Name="RecordingStopIcon" Width="10" Height="10"
                                       Fill="#FF5964" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <ToggleButton x:Name="MonitorCheckBox" Width="36" Height="36" Padding="0"
                                  Margin="3,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Monitor input" ToolTip="Monitor input"
                                  Checked="Monitor_Changed" Unchecked="Monitor_Changed">
                        <Path Data="M 4,13 C 4,8 7.6,4 12,4 C 16.4,4 20,8 20,13 M 4,13 L 4,18 C 4,19.1 4.9,20 6,20 L 8,20 L 8,13 L 6,13 C 4.9,13 4,13.9 4,15 M 20,13 L 20,18 C 20,19.1 19.1,20 18,20 L 16,20 L 16,13 L 18,13 C 19.1,13 20,13.9 20,15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="22" Height="22" />
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#2B2C36" />
                                <Setter Property="Foreground" Value="#C4C3CF" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#E6AE62" />
                                        <Setter Property="Foreground" Value="#17131F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBox x:Name="TempoTextBox" Text="128" Width="48" MaxLength="3"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             ToolTip="Tempo in quarter notes per minute (20-300 BPM)" />
                    <TextBlock Text="BPM" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                               FontSize="10" Margin="4,0,10,0" />
                    <ComboBox x:Name="TimeSignatureComboBox" Width="66" Height="28"
                              Background="#F6F4FA" Foreground="#17131F" BorderBrush="#555662"
                              VerticalContentAlignment="Center" ToolTip="Time signature (for example 4/4)">
                        <ComboBoxItem Content="2/4" />
                        <ComboBoxItem Content="3/4" />
                        <ComboBoxItem Content="4/4" />
                        <ComboBoxItem Content="5/4" />
                        <ComboBoxItem Content="6/8" />
                        <ComboBoxItem Content="7/8" />
                        <ComboBoxItem Content="12/8" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="ZOOM" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                               FontSize="10" FontWeight="Bold" Margin="12,0,8,0" />
                    <Button Content="−" Width="34" Click="ZoomOut_Click" />
                    <TextBlock x:Name="ZoomText" Text="75 px/bar" Width="70" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="#D8D6E0" />
                    <Button Content="+" Width="34" Click="ZoomIn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="12"
                    BorderBrush="#2C2D36" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="222" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="#202129"
                            BorderBrush="#30313A" BorderThickness="0,0,1,1">
                        <TextBlock Text="TRACKS" Margin="17,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedText}" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <ScrollViewer Grid.Row="0" Grid.Column="1" x:Name="RulerScroll"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Background="#202129">
                        <Canvas x:Name="TimelineRuler" Height="40" Background="#202129" />
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="HeaderScroll"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TrackHeaders" />
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="TimelineScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource Panel}"
                                  ScrollChanged="TimelineScroll_Changed"
                                  AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop">
                        <StackPanel x:Name="TrackLanes" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <Button Grid.Row="1" HorizontalAlignment="Left" Margin="4,9,0,0"
                    Content="+  Add track" Click="AddTrack_Click" />
        </Grid>

        <Border Grid.Row="2" Background="#191A20" BorderBrush="#2A2B33" BorderThickness="0,1,0,0">
            <DockPanel Margin="22,0">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock Text="Click timeline to place playhead  ·  Drag clips to arrange  ·  Record a take"
                           Foreground="#70717D" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
